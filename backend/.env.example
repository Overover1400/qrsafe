# Server
PORT=8080
ENV=development
# Public base URL used to build redirect links for dynamic codes (/r/{slug}).
# Defaults to production; for local dev override to http://localhost:8080.
PUBLIC_BASE_URL=https://api.qrsafe.flemby.com

# Database
DATABASE_URL=postgres://qrsafe:CHANGEME@localhost:5432/qrsafe_dev?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGEME
REDIS_DB=0

# Auth
JWT_SECRET=replace-with-base64-of-32-random-bytes
JWT_TTL_HOURS=168

# Rate limiting: per-IP requests/minute for /api/v1 (<=0 disables).
RATE_LIMIT_RPM=60

# CORS: comma-separated list of browser origins allowed to call the API.
# Whitespace around each item is trimmed. When unset/empty the server falls back
# to: https://app.qrsafe.flemby.com,http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=https://app.qrsafe.flemby.com,http://localhost:3000,http://localhost:8000
