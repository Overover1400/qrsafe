# Server
PORT=8080
ENV=development
# Public base URL used to build redirect links for dynamic codes (/r/{slug}).
PUBLIC_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://qrsafe:CHANGEME@localhost:5432/qrsafe_dev?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGEME
REDIS_DB=0

# Auth
JWT_SECRET=replace-with-base64-of-32-random-bytes
JWT_TTL_HOURS=168

# Rate limiting: per-IP requests/minute for /api/v1 (<=0 disables).
RATE_LIMIT_RPM=60
